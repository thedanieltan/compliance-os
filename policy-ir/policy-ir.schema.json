{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://compliance-os.dev/policy-ir/policy-ir.schema.json",
  "title": "Canonical Policy IR Package",
  "type": "object",
  "required": ["package_manifest", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "package_manifest": {
      "type": "object",
      "required": ["package_id", "version", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "schema_version": { "const": "policy-ir.v1" },
        "publisher": { "type": "string" },
        "licensing": { "$ref": "#/definitions/licensing" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package", "version"],
            "additionalProperties": false,
            "properties": {
              "package": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    }
  },
  "definitions": {
    "licensing": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["OPEN", "REFERENCE_ONLY", "RESTRICTED"] },
        "embedded_content": { "type": "boolean" },
        "redistribution": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "required": { "type": "boolean" },
        "relation": { "type": ["string", "null"] },
        "emit_on_outcomes": {
          "type": "array",
          "items": { "$ref": "#/definitions/outcome" }
        }
      }
    },
    "outcome": {
      "enum": [
        "PASS", "FAIL", "ALLOW", "DENY", "NOT_APPLICABLE",
        "INSUFFICIENT_INFORMATION", "EVIDENCE_GAP", "REQUIRES_REVIEW",
        "REQUIRE_APPROVAL", "REQUIRE_ATTESTATION", "HUMAN_DECISION_REQUIRED",
        "FACT_CONFLICT", "POLICY_CONFLICT", "NO_AUTHORITATIVE_DECISION",
        "PROHIBITED_AUTOMATION", "ERROR"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id", "artifact_type", "schema_version", "artifact_version",
        "status", "publisher_ref", "source_refs", "provenance", "valid_from",
        "valid_to", "content_hash", "licensing"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "artifact_type": {
          "enum": [
            "POLICY_SOURCE", "AUTHORITY_REFERENCE", "INTERPRETATION",
            "FACT_DEFINITION", "OBLIGATION", "CONTROL", "EVIDENCE_CONTRACT",
            "POLICY_RULE", "APPROVAL_REQUIREMENT", "EXCEPTION_POLICY",
            "OVERRIDE_POLICY", "WORKFLOW_EFFECT", "DECISION_SCHEMA",
            "FRAMEWORK_MAPPING", "CONFLICT", "MIGRATION", "PACKAGE_MANIFEST"
          ]
        },
        "schema_version": { "const": "policy-ir.v1" },
        "artifact_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["DRAFT", "PROPOSED", "ACTIVE", "SUPERSEDED", "DEPRECATED", "REVOKED"] },
        "publisher_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
        "references": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
        "provenance": { "type": "string", "minLength": 1 },
        "valid_from": { "type": ["string", "null"] },
        "valid_to": { "type": ["string", "null"] },
        "recorded_at": { "type": ["string", "null"] },
        "superseded_at": { "type": ["string", "null"] },
        "jurisdiction_refs": { "type": "array", "items": { "type": "string" } },
        "scope_refs": { "type": "array", "items": { "type": "string" } },
        "content_hash": { "type": ["string", "null"] },
        "licensing": { "$ref": "#/definitions/licensing" },
        "body": { "type": "object" },
        "extensions": { "type": "object" }
      }
    }
  }
}
