{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compliance-os:schema:compliance-object-primitives:v1",
  "title": "ComplianceObjectPrimitive",
  "description": "Domain-neutral requirement, obligation, assessment, finding, and remediation records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "recordType", "schemaVersion", "workspaceId", "title", "state", "scope", "subjectRefs", "relationships", "ownership", "provenance", "lifecycle", "extensions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "recordType": { "enum": ["requirement", "obligation", "assessment", "finding", "remediation"] },
    "schemaVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "state": { "enum": ["draft", "active", "closed", "superseded", "cancelled"] },
    "scope": { "type": "object" },
    "subjectRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "relationships": { "type": "object" },
    "ownership": { "type": "object" },
    "provenance": { "type": "object" },
    "lifecycle": { "type": "object" },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" } }
  }
}
